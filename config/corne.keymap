#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define NUMPAD 3
#define GAMING 4
#define GAME_FN 5
#define MODES 6

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        mode_selector {
            if-layers = <LOWER RAISE>;
            then-layer = <MODES>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB  |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BKSP |
            // | CTRL  |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
            // | SHFT  |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | RSHFT|
            //                    | GUI | LWR | ENT |   | SPC | RSE | RALT|

            display-name = "Base";
            bindings = <
&kp ESCAPE        &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y      &kp U  &kp I          &kp O    &kp P     &kp BSPC
&kp TAB           &kp A  &kp S  &kp D     &kp F  &kp G        &kp H      &kp J  &kp K          &kp L    &kp SEMI  &kp APOS
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N      &kp M  &kp COMMA      &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                                &kp LGUI  &mo 1  &kp ENTER    &kp SPACE  &mo 2  &kp RIGHT_ALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&trans  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &trans
&trans  &trans    &trans  &trans    &trans    &trans       &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &trans    &trans  &trans    &trans    &trans       &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE  &kp TILDE
                          &trans    &trans    &kp SPACE    &kp RET    &trans     &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise Layer";
            bindings = <
&trans      &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6    &kp N7    &kp N8  &kp N9     &kp N0  &trans
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans          &trans    &trans    &trans  &trans     &trans  &trans
                                        &kp LEFT_ALT  &trans        &kp SPACE       &kp RET   &trans    &trans
            >;
        };

        numpad_layer {
            display-name = "Numpad";
            bindings = <
&kp TAB     &kp N1        &kp N2        &kp N3        &kp N4                &kp N5                   &kp PLUS      &kp N7        &kp N8        &kp N9        &kp MINUS  &kp BSPC
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3          &bt BT_SEL 4             &kp LEFT      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp RIGHT  &kp EQUAL
&kp LSHFT   &trans        &trans        &trans        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH  &kp KP_MULTIPLY
                                        &kp LGUI      &trans                &kp SPACE                &kp RET       &trans        &trans
            >;
        };

        gaming_layer {
            display-name = "Gaming";
            bindings = <
&kp ESCAPE        &kp Q  &kp W  &kp E  &kp R  &kp T       &kp Y         &kp U      &kp I      &kp O    &kp P     &kp BSPC
&kp TAB           &kp A  &kp S  &kp D  &kp F  &kp G       &kp H         &kp J      &kp K      &kp L    &kp SEMI  &kp APOS
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C  &kp V  &kp B       &kp N         &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                              &mo GAME_FN  &kp LEFT_SHIFT  &kp SPACE    &kp LEFT_ALT  &kp ENTER  &to BASE
            >;
        };

        game_fn_layer {
            // Keep movement, sprint and jump available while holding Fn.
            // Fn + physical F sends Alt for the weapon wheel, with no F keypress.
            display-name = "Game Fn";
            bindings = <
&to BASE          &kp N1  &kp W  &kp N2  &kp N3        &kp N4    &kp N1    &kp N2    &kp N3  &kp N4     &kp N5  &kp F5
&kp CAPSLOCK      &kp A   &kp S  &kp D   &kp LEFT_ALT  &kp H     &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp F1  &kp DELETE
&kp LEFT_CONTROL  &kp O   &kp M  &kp J   &kp N         &kp P     &kp N6    &kp N7    &kp N8  &kp N9     &kp N0  &kp F9
                                &mo GAME_FN  &kp LEFT_SHIFT  &kp SPACE    &kp LEFT_ALT  &kp ENTER  &to BASE
            >;
        };

        modes_layer {
            // Lower + Raise: G = Gaming, N = Numpad, Esc = Base.
            // Block other keys, including the underlying BT_CLR position.
            display-name = "Modes";
            bindings = <
&to BASE  &none  &none  &none  &none  &none         &none       &none  &none  &none  &none  &none
&none     &none  &none  &none  &none  &to GAMING    &none       &none  &none  &none  &none  &none
&none     &none  &none  &none  &none  &none         &to NUMPAD  &none  &none  &none  &none  &none
                       &none  &trans  &none        &none       &trans  &none
            >;
        };
    };
};
